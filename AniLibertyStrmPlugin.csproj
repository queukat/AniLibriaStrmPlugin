<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PublishSingleFile>false</PublishSingleFile>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <RootNamespace>AniLibertyStrmPlugin</RootNamespace>
    </PropertyGroup>

    <ItemGroup>

        <!--   Jellyfin -->
        <!--    10.11 -->
        <PackageReference Include="Jellyfin.Controller" Version="10.11.*-*" PrivateAssets="all"/>
        <PackageReference Include="Jellyfin.Model" Version="10.11.*-*" PrivateAssets="all"/>

        <!--  ,     -->
        <PackageReference Include="Jellyfin.Database.Implementations" Version="10.11.*-*" PrivateAssets="all"/>
        <PackageReference Include="Jellyfin.MediaEncoding.Keyframes" Version="10.11.*-*" PrivateAssets="all"/>


        <!-- Polly   HTTP -->
        <PackageReference Include="Polly" Version="8.6.*">
            <PrivateAssets>none</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.0">
            <PrivateAssets>none</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" PrivateAssets="all"/>

        <Compile Remove="AniLibertyStrmPlugin.Tests\**\*.cs;Tests\**\*.cs"/>

    </ItemGroup>
    <ItemGroup>
        <None Include="Resources\icon.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <TargetPath>icon.png</TargetPath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Configuration\configPage.html" LogicalName="AniLibertyStrmPlugin.Configuration.configPage.html"/>


        <EmbeddedResource Include="Resources\icon.png"/>
    </ItemGroup>


    <ItemGroup>
        <Folder Include="AniLibertyStrmPlugin.Tests\bin\Debug\"/>
        <Folder Include="AniLibertyStrmPlugin.Tests\obj\Debug\"/>
    </ItemGroup>
    <Target Name="ShowPluginOutputPath" AfterTargets="Build">
        <Message Text="Plugin DLL built at: $(TargetDir)$(TargetFileName)" Importance="high"/>
    </Target>


</Project>
