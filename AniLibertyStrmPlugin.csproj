<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PublishSingleFile>false</PublishSingleFile>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <RootNamespace>AniLibertyStrmPlugin</RootNamespace>
        <Version>2.0.0.13</Version>
        <AssemblyVersion>2.0.0.13</AssemblyVersion>
        <FileVersion>2.0.0.13</FileVersion>
        <InformationalVersion>2.0.0.13</InformationalVersion>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <ItemGroup>

        <!--   Jellyfin -->
        <!--    12 -->
        <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc6" PrivateAssets="all"/>
        <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc6" PrivateAssets="all"/>

        <!--  ,     -->
        <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.0-rc6" PrivateAssets="all"/>
        <PackageReference Include="Jellyfin.MediaEncoding.Keyframes" Version="12.0.0-rc6" PrivateAssets="all"/>


        <!-- Polly   HTTP -->
        <PackageReference Include="Polly" Version="8.7.0">
            <PrivateAssets>none</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.11">
            <PrivateAssets>none</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" PrivateAssets="all"/>

        <Compile Remove="AniLibertyStrmPlugin.Tests\**\*.cs;Tests\**\*.cs"/>

    </ItemGroup>
    <ItemGroup>
        <None Include="Resources\icon.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <TargetPath>icon.png</TargetPath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Configuration\configPage.html" LogicalName="AniLibertyStrmPlugin.Configuration.configPage.html"/>


        <EmbeddedResource Include="Resources\icon.png"/>
    </ItemGroup>


    <ItemGroup>
        <Folder Include="AniLibertyStrmPlugin.Tests\bin\Debug\"/>
        <Folder Include="AniLibertyStrmPlugin.Tests\obj\Debug\"/>
    </ItemGroup>
    <Target Name="ShowPluginOutputPath" AfterTargets="Build">
        <Message Text="Plugin DLL built at: $(TargetDir)$(TargetFileName)" Importance="high"/>
    </Target>

    <Target Name="RemoveConflictingSharedAssemblies" AfterTargets="CopyFilesToPublishDirectory">
        <ItemGroup>
            <ConflictingPublishAssemblies Include="$(PublishDir)Microsoft.Extensions.Configuration.Abstractions.dll"/>
            <ConflictingPublishAssemblies Include="$(PublishDir)Microsoft.Extensions.Configuration.Binder.dll"/>
            <ConflictingPublishAssemblies Include="$(PublishDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll"/>
            <ConflictingPublishAssemblies Include="$(PublishDir)Microsoft.Extensions.DependencyInjection.dll"/>
            <ConflictingPublishAssemblies Include="$(PublishDir)Microsoft.Extensions.Logging.Abstractions.dll"/>
            <ConflictingPublishAssemblies Include="$(PublishDir)Microsoft.Extensions.Logging.dll"/>
            <ConflictingPublishAssemblies Include="$(PublishDir)Microsoft.Extensions.Options.dll"/>
            <ConflictingPublishAssemblies Include="$(PublishDir)Microsoft.Extensions.Primitives.dll"/>
        </ItemGroup>

        <Delete Files="@(ConflictingPublishAssemblies)" TreatErrorsAsWarnings="true"/>
    </Target>


</Project>
